# Banco de dados
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=


# Rails
RAILS_MAX_THREADS=5
RAILS_ENV=development

# JWT
JWT_SECRET_KEY=changeme_generate_a_long_random_secret

# Front-end (CORS)
FRONTEND_URL=http://localhost:3001

# Impressora de recibos (ESC/POS) - ver config/store_profiles.yml
# none = só prévia | network = impressora de rede | file = USB compartilhada (Windows) ou /dev/usb/lp0
RECEIPT_PRINTER_MODE=none
RECEIPT_PRINTER_HOST=
RECEIPT_PRINTER_PORT=9100
RECEIPT_PRINTER_PATH=
